---
import Base from '../layouts/Base.astro';
const plans = [
  { name: 'Postpaid 39', data: '30GB', price: 39 },
  { name: 'Postpaid 69', data: '100GB', price: 69 },
  { name: 'Postpaid 99', data: 'Unlimited', price: 99 },
];
---
<Base title="Mobile">
  <section class="section">
    <div class="container">
      <p class="eyebrow">Mobile</p>
      <h2>Postpaid plans that pair with your fibre.</h2>
      <p class="lead">5G included on every plan. Bundle with Home Fibre and save RM20 a month per line.</p>
      <div class="grid grid-3" style="margin-top:2rem">
        {plans.map(p => (
          <div class="card">
            <h3>{p.name}</h3>
            <p class="data">{p.data} <small>5G data</small></p>
            <p class="price"><small>RM</small>{p.price}<small>/mth</small></p>
            <a href="/#coverage" class="btn btn-outline">Choose plan</a>
          </div>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .data { font-weight: 700; font-size: 1.4rem; color: var(--navy); }
  .data small { color: var(--muted); font-weight: 500; font-size: .9rem; }
  .price { font-size: 2.4rem; font-weight: 900; color: var(--navy); }
  .price small { font-size: 1rem; color: var(--muted); margin: 0 4px; }
</style>
