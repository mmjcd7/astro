---
import { loadHero } from '../lib/cms';
const hero = (await loadHero()) ?? {
  eyebrow: 'Home Fibre',
  heading: 'Fibre that keeps up with the whole house.',
  subheading: 'Up to 2Gbps symmetric speeds, mesh Wi-Fi included, and installation in as fast as 3 working days.',
  speedNumber: '2',
  speedUnit: 'Gbps',
};
const num = hero.speedNumber ?? hero.speed_number ?? '2';
const unit = hero.speedUnit ?? hero.speed_unit ?? 'Gbps';
---
<section class="hero">
  <div class="container inner">
    <div>
      <p class="eyebrow light">{hero.eyebrow}</p>
      <h1>{hero.heading}</h1>
      <p class="lead light">{hero.subheading}</p>
      <div class="cta">
        <a href="#plans" class="btn btn-primary">See plans</a>
        <a href="#coverage" class="btn btn-ghost">Check coverage</a>
      </div>
    </div>
    <div class="speed" aria-hidden="true">
      <div class="ring"></div>
      <div class="num"><span>{num}</span>{unit}</div>
      <div class="sub">symmetric download / upload</div>
    </div>
  </div>
  <a class="credit" href="https://commons.wikimedia.org/wiki/File:Kuala_Lumpur,_Malaysia,_KLCC_from_KL_Tower.jpg" target="_blank" rel="noopener">Photo: Vyacheslav Argenberg, CC BY 4.0</a>
</section>

<style>
  .hero {
    position: relative;
    background:
      linear-gradient(90deg, rgba(11,27,58,.92) 0%, rgba(11,27,58,.7) 55%, rgba(11,27,58,.45) 100%),
      url('/hero-klcc.jpg') center / cover no-repeat;
    color: #fff;
    padding: 96px 0;
  }
  .credit { position: absolute; right: 12px; bottom: 8px; font-size: .7rem; color: rgba(255,255,255,.5); }
  .credit:hover { color: rgba(255,255,255,.85); }
  .inner { display: grid; grid-template-columns: 1.2fr 1fr; gap: 48px; align-items: center; }
  .light { color: rgba(255,255,255,.75); }
  .eyebrow.light { color: var(--orange); }
  .cta { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 1.5rem; }
  .speed { position: relative; aspect-ratio: 1; max-width: 360px; margin: 0 auto; display: grid; place-items: center; text-align: center; }
  .ring { position: absolute; inset: 0; border-radius: 50%; border: 14px solid rgba(255,255,255,.08); border-top-color: var(--orange); border-right-color: var(--orange); animation: spin 6s linear infinite; }
  .num { font-size: 4.5rem; font-weight: 900; letter-spacing: -.04em; }
  .num span { font-size: 6rem; color: var(--orange); }
  .sub { color: rgba(255,255,255,.6); }
  @keyframes spin { to { transform: rotate(360deg); } }
  @media (max-width: 860px) { .inner { grid-template-columns: 1fr; } .hero { padding: 64px 0; } }
</style>
