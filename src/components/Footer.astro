---
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="container cols">
    <div>
      <div class="logo">uni<b>fi</b></div>
      <p>Sample site built with Astro, inspired by unifi.com.my. Not affiliated with Telekom Malaysia.</p>
    </div>
    <div><h4>Products</h4><a href="/#plans">Home Fibre</a><a href="/mobile">Mobile</a><a href="/#tv">TV</a></div>
    <div><h4>Help</h4><a href="/#support">Support</a><a href="/#coverage">Coverage</a><a href="/">Stores</a></div>
    <div><h4>Company</h4><a href="/">About</a><a href="/">Careers</a><a href="/">Press</a></div>
  </div>
  <div class="container legal">© {year} demo · Deployed on k3s via ArgoCD</div>
</footer>

<style>
  .footer { background: var(--navy); color: rgba(255,255,255,.7); padding: 56px 0 24px; margin-top: 48px; }
  .cols { display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 32px; }
  .logo { font-size: 1.5rem; font-weight: 800; color: #fff; }
  .logo b { color: var(--orange); }
  h4 { color: #fff; margin: 0 0 .75rem; }
  .cols a { display: block; padding: 4px 0; }
  .cols a:hover { color: var(--orange); }
  .legal { border-top: 1px solid rgba(255,255,255,.1); margin-top: 40px; padding-top: 20px; font-size: .85rem; }
  @media (max-width: 720px) { .cols { grid-template-columns: 1fr 1fr; } }
</style>
